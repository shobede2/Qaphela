<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Warn Your Community (CPF / WhatsApp) 📢"
            android:textColor="@color/burgundy_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- PII Scrubber Status Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/light_pink"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="🔒 Privacy Shield Active: Personal phone numbers, names, and exact addresses are automatically redacted to prevent defamation and vigilante harm."
                android:textColor="@color/text_main"
                android:textSize="12sp" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_community_area"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxStrokeColor="@color/burgundy_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_community_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Suburban Region (e.g. Sandton, Soweto)"
                android:inputType="text"
                android:textColor="@color/text_main" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_community_desc"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxStrokeColor="@color/burgundy_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_community_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Describe the scam pattern..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/text_main" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_community"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/burgundy_primary"
            android:text="Share Warning via Share-Sheet"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_report"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

    </LinearLayout>

</ScrollView>