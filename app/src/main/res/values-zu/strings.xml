    <!-- Privacy, Help, About Content -->
    <string name="privacy_content_title">Inqubomgomo Yobumfihlo</string>
    <string name="privacy_content_body">1. Ukusebenza Kwasekhaya: I-Qaphela isebenzisa ukuhlola kudivayisi yakho kuphela ukuvikela ubumfihlo wakho.\n\n2. Ukugcina Umlando: Imiphumela igcinwa kudivayisi yakho uma ulandela izilungiselelo.\n\n3. Akukho ukuthunyelwa kwasendlini okuvela kumsebenzisi ngaphandle kokubika.</string>

    <string name="help_content_title">Indlela Yokusebenzisa I-Qaphela</string>
    <string name="help_content_body">1. Indlela yokuhlola i-SMS: Kopisha umbhalo womlayezo, chofoza \'Hlola I-SMS\', faka umbhalo, bese uchofoza \'Hlola Umlayezo\'.\n\n2. Indlela yokuhlola isixhumanisi: Chofoza \'Hlola Isixhumanisi\', faka isixhumanisi bese ucindezela ukuhlola.</string>

    <string name="about_content_title">Mayelana ne-Qaphela</string>
    <string name="about_content_body">Qaphela v1.0\n\"Qaphela. Hlala Uphephile.\"\n\nI-Qaphela ingeyokuvikela abasebenzisi baseNingizimu Afrika kubugebengu base-inthanethi ne-SMS eyisiphambeko.</string>
